+mlx5_rx(const char *dev, uint32_t rqn, uint16_t wqe_counter, size_t len) "%s: rqn 0x%x wqe counter %u len %zu"
+mlx5_rx_drop(const char *dev, const char *reason, size_t len) "%s: %s (len %zu)"
 mlx5_port_event(bool up) "link up %d"
