 mlx5_cq_post(uint32_t cqn, uint32_t pi, uint8_t opcode, uint16_t wqe_counter, uint64_t ts) "cqn 0x%x pi %u opcode %u wqe_counter %u timestamp %"PRIu64
 mlx5_cq_doorbell(uint32_t cqn, uint32_t ci, uint32_t pi) "cqn 0x%x ci %u pi %u"
