+/*
+ * Verify a received frame's IPv4 header checksum and TCP/UDP checksum, for
+ * the "checksum OK" flags in the completion.
+ */
+static void mlx5_rx_csum_verify(const uint8_t *buf, size_t len,
+                                const MLX5PktInfo *pi, bool *l3_ok,
+                                bool *l4_ok)
+{
+    const uint8_t *ip = buf + pi->l3_off;
+    const uint8_t *l4h = buf + pi->l4_off;
+    size_t hdr_len = pi->l4_off - pi->l3_off;
+    size_t l4_len;
+    uint32_t sum;
+
+    *l3_ok = *l4_ok = false;
+    if (pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV4) {
+        size_t ihl = (ip[0] & 0xf) * 4;
+        size_t total = lduw_be_p(ip + 2);
+
+        *l3_ok = mlx5_csum_fold(net_checksum_add(ihl, (uint8_t *)ip)) ==
+                 0xffff;
+        if (!pi->l4_proto || total < hdr_len) {
+            return;
+        }
+        l4_len = total - hdr_len;
+        sum = net_checksum_add(8, (uint8_t *)ip + 12);
+    } else if (pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV6) {
+        *l3_ok = true;
+        if (!pi->l4_proto) {
+            return;
+        }
+        l4_len = lduw_be_p(ip + 4);
+        sum = net_checksum_add(32, (uint8_t *)ip + 8);
+    } else {
+        return;
+    }
+
+    if (l4_len < (pi->l4_proto == IP_PROTO_TCP ? sizeof(struct tcp_header) :
+                                                 sizeof(struct udp_header)) ||
+        pi->l4_off + l4_len > len) {
+        return;
+    }
+    if (pi->l4_proto == IP_PROTO_UDP && !lduw_be_p(l4h + 6) &&
+        pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV4) {
+        /* UDP over IPv4 sent without a checksum. */
+        *l4_ok = true;
+        return;
+    }
+    sum += pi->l4_proto + l4_len;
+    sum += net_checksum_add(l4_len, (uint8_t *)l4h);
+    *l4_ok = mlx5_csum_fold(sum) == 0xffff;
+}
