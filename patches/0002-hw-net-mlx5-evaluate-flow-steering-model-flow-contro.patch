+++ b/hw/net/mlx5/mlx5_fs.c
@@ -0,0 +1,673 @@
+/*
+ * Mellanox ConnectX (mlx5) emulation: receive flow steering
+ *
+ * The driver programs how received frames are classified:
+ *
+ *  - A flow table holds flow table entries (FTEs) ordered by index.  Each
+ *    FTE belongs to a flow group, which says which header fields the entries
+ *    in its index range match on; the FTE supplies the values.
+ *  - The lowest-index matching FTE decides: drop the frame, or forward it
+ *    to further flow tables and/or to TIRs.  A frame no FTE matches goes to
+ *    the table's miss table if it has one and is dropped otherwise.
+ *  - A TIR (transport interface receive) picks the receive queue: a fixed
+ *    one, or one from an RQ table indexed by the RSS hash of the fields the
+ *    TIR selects.
+ *
+ * Classification starts at the table the driver made the root.  Only the
+ * outer Ethernet/VLAN/IP/TCP/UDP fields are matched; rules on tunnel or
+ * metadata fields only match if they ask for zero.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "mlx5.h"
+#include "../trace.h"
+
+#define MLX5_FT_NIC_RX          0x0
+
+/* fte_match_param is a sequence of equally sized sections. */
+#define MLX5_MATCH_SECTION_SIZE MLX5_ST_SZ_BYTES(fte_match_set_lyr_2_4)
+#define MLX5_MATCH_SECTIONS     7
+#define MLX5_MATCH_SIZE         (MLX5_MATCH_SECTION_SIZE * MLX5_MATCH_SECTIONS)
+
+#define MLX5_FS_MAX_DEPTH       64
+
+typedef struct MLX5FlowDest {
+    uint8_t type;
+    uint32_t id;
+} MLX5FlowDest;
+
+typedef struct MLX5Fte {
+    uint32_t group_id;
+    uint32_t action;
+    uint32_t flow_tag;
+    uint32_t ndests;
+    MLX5FlowDest *dests;
+    uint8_t value[MLX5_MATCH_SIZE];
+} MLX5Fte;
+
+typedef struct MLX5FlowGroup {
+    uint8_t criteria_enable;    /* bit n: section n of the mask is in use */
+    uint8_t mask[MLX5_MATCH_SIZE];
+} MLX5FlowGroup;
+
+typedef struct MLX5FlowTable {
+    uint8_t type;
+    bool miss_fwd;
+    uint32_t miss_table_id;
+    GHashTable *groups;         /* group id -> MLX5FlowGroup */
+    GTree *ftes;                /* flow index -> MLX5Fte, in index order */
+} MLX5FlowTable;
+
+static void mlx5_fte_free(gpointer data)
+{
+    MLX5Fte *fte = data;
+
+    g_free(fte->dests);
+    g_free(fte);
+}
+
+static void mlx5_flow_table_free(gpointer data)
+{
+    MLX5FlowTable *ft = data;
+
+    g_hash_table_destroy(ft->groups);
+    g_tree_destroy(ft->ftes);
+    g_free(ft);
+}
+
+static gint mlx5_index_cmp(gconstpointer a, gconstpointer b, gpointer data)
+{
+    uint32_t x = GPOINTER_TO_UINT(a), y = GPOINTER_TO_UINT(b);
+
+    return x < y ? -1 : x > y;
+}
+
+static MLX5FlowTable *mlx5_flow_table_get(MLX5State *s, uint32_t id)
+{
+    return g_hash_table_lookup(s->flow_tables, GUINT_TO_POINTER(id));
+}
+
+/*
+ * Commands
+ */
+
+static void mlx5_flow_table_set_miss(MLX5FlowTable *ft, const uint8_t *ctx)
+{
+    ft->miss_fwd = MLX5_GET(flow_table_context, ctx, table_miss_action) ==
+                   MLX5_FLOW_TABLE_MISS_ACTION_FWD;
+    ft->miss_table_id = MLX5_GET(flow_table_context, ctx, table_miss_id);
+}
+
+int mlx5_cmd_create_flow_table(MLX5State *s, const uint8_t *in,
+                               uint32_t inlen, uint8_t *out, uint32_t outlen)
+{
+    MLX5FlowTable *ft;
+    uint32_t id;
+
+    MLX5_CMD_CHECK_LEN(create_flow_table_in, create_flow_table_out);
+    ft = g_new0(MLX5FlowTable, 1);
+    ft->type = MLX5_GET(create_flow_table_in, in, table_type);
+    ft->groups = g_hash_table_new_full(NULL, NULL, NULL, g_free);
+    ft->ftes = g_tree_new_full(mlx5_index_cmp, NULL, NULL, mlx5_fte_free);
+    mlx5_flow_table_set_miss(ft, MLX5_ADDR_OF(create_flow_table_in, in,
+                                              flow_table_context));
+    id = mlx5_alloc_id(s);
+    g_hash_table_insert(s->flow_tables, GUINT_TO_POINTER(id), ft);
+    trace_mlx5_flow_table(id, ft->type, ft->miss_fwd, ft->miss_table_id);
+    MLX5_SET(create_flow_table_out, out, table_id, id);
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_modify_flow_table(MLX5State *s, const uint8_t *in,
+                               uint32_t inlen, uint8_t *out, uint32_t outlen)
+{
+    MLX5FlowTable *ft;
+    uint32_t id;
+
+    MLX5_CMD_CHECK_LEN(modify_flow_table_in, modify_flow_table_out);
+    id = MLX5_GET(modify_flow_table_in, in, table_id);
+    ft = mlx5_flow_table_get(s, id);
+    if (!ft) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    if (MLX5_GET(modify_flow_table_in, in, modify_field_select) &
+        MLX5_MODIFY_FLOW_TABLE_MISS_TABLE_ID) {
+        mlx5_flow_table_set_miss(ft, MLX5_ADDR_OF(modify_flow_table_in, in,
+                                                  flow_table_context));
+        trace_mlx5_flow_table(id, ft->type, ft->miss_fwd, ft->miss_table_id);
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_destroy_flow_table(MLX5State *s, const uint8_t *in,
+                                uint32_t inlen, uint8_t *out, uint32_t outlen)
+{
+    uint32_t id;
+
+    MLX5_CMD_CHECK_LEN(destroy_flow_table_in, destroy_flow_table_out);
+    id = MLX5_GET(destroy_flow_table_in, in, table_id);
+    if (!g_hash_table_remove(s->flow_tables, GUINT_TO_POINTER(id))) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    if (s->rx_root_valid && s->rx_root_ft == id) {
+        s->rx_root_valid = false;
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_set_flow_table_root(MLX5State *s, const uint8_t *in,
+                                 uint32_t inlen, uint8_t *out,
+                                 uint32_t outlen)
+{
+    uint32_t id;
+
+    MLX5_CMD_CHECK_LEN(set_flow_table_root_in, set_flow_table_root_out);
+    id = MLX5_GET(set_flow_table_root_in, in, table_id);
+    if (MLX5_GET(set_flow_table_root_in, in, table_type) == MLX5_FT_NIC_RX) {
+        s->rx_root_ft = id;
+        s->rx_root_valid = true;
+        trace_mlx5_flow_root(id);
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_create_flow_group(MLX5State *s, const uint8_t *in,
+                               uint32_t inlen, uint8_t *out, uint32_t outlen)
+{
+    MLX5FlowTable *ft;
+    MLX5FlowGroup *fg;
+    uint32_t id;
+
+    MLX5_CMD_CHECK_LEN(create_flow_group_in, create_flow_group_out);
+    ft = mlx5_flow_table_get(s, MLX5_GET(create_flow_group_in, in, table_id));
+    if (!ft) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    fg = g_new0(MLX5FlowGroup, 1);
+    fg->criteria_enable = MLX5_GET(create_flow_group_in, in,
+                                   match_criteria_enable);
+    memcpy(fg->mask, MLX5_ADDR_OF(create_flow_group_in, in, match_criteria),
+           sizeof(fg->mask));
+    id = mlx5_alloc_id(s);
+    g_hash_table_insert(ft->groups, GUINT_TO_POINTER(id), fg);
+    MLX5_SET(create_flow_group_out, out, group_id, id);
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_destroy_flow_group(MLX5State *s, const uint8_t *in,
+                                uint32_t inlen, uint8_t *out, uint32_t outlen)
+{
+    MLX5FlowTable *ft;
+
+    MLX5_CMD_CHECK_LEN(destroy_flow_group_in, destroy_flow_group_out);
+    ft = mlx5_flow_table_get(s, MLX5_GET(destroy_flow_group_in, in,
+                                         table_id));
+    if (!ft || !g_hash_table_remove(ft->groups, GUINT_TO_POINTER(
+                    MLX5_GET(destroy_flow_group_in, in, group_id)))) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+/* Creates an entry or, with op_mod 1, replaces an existing one. */
+int mlx5_cmd_set_fte(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                     uint8_t *out, uint32_t outlen)
+{
+    const uint8_t *ctx, *dest;
+    MLX5FlowTable *ft;
+    MLX5Fte *fte;
+    uint32_t index, i;
+
+    MLX5_CMD_CHECK_LEN(set_fte_in, set_fte_out);
+    ft = mlx5_flow_table_get(s, MLX5_GET(set_fte_in, in, table_id));
+    if (!ft) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    index = MLX5_GET(set_fte_in, in, flow_index);
+    ctx = MLX5_ADDR_OF(set_fte_in, in, flow_context);
+    dest = MLX5_ADDR_OF(flow_context, ctx, destination);
+
+    fte = g_new0(MLX5Fte, 1);
+    fte->group_id = MLX5_GET(flow_context, ctx, group_id);
+    fte->action = MLX5_GET(flow_context, ctx, action);
+    fte->flow_tag = MLX5_GET(flow_context, ctx, flow_tag);
+    fte->ndests = MLX5_GET(flow_context, ctx, destination_list_size);
+    memcpy(fte->value, MLX5_ADDR_OF(flow_context, ctx, match_value),
+           sizeof(fte->value));
+    if (!(fte->action & MLX5_FLOW_CONTEXT_ACTION_FWD_DEST)) {
+        fte->ndests = 0;
+    }
+    if (fte->ndests > (in + inlen - dest) /
+                      MLX5_ST_SZ_BYTES(dest_format_struct)) {
+        g_free(fte);
+        return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
+    }
+    fte->dests = g_new(MLX5FlowDest, fte->ndests);
+    for (i = 0; i < fte->ndests; i++) {
+        fte->dests[i].type = MLX5_GET(dest_format_struct, dest,
+                                      destination_type);
+        fte->dests[i].id = MLX5_GET(dest_format_struct, dest, destination_id);
+        dest += MLX5_ST_SZ_BYTES(dest_format_struct);
+    }
+    trace_mlx5_set_fte(MLX5_GET(set_fte_in, in, table_id), index,
+                       fte->group_id, fte->action, fte->ndests,
+                       fte->ndests ? fte->dests[0].type : 0,
+                       fte->ndests ? fte->dests[0].id : 0);
+    g_tree_replace(ft->ftes, GUINT_TO_POINTER(index), fte);
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_delete_fte(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                        uint8_t *out, uint32_t outlen)
+{
+    MLX5FlowTable *ft;
+
+    MLX5_CMD_CHECK_LEN(delete_fte_in, delete_fte_out);
+    ft = mlx5_flow_table_get(s, MLX5_GET(delete_fte_in, in, table_id));
+    if (!ft || !g_tree_remove(ft->ftes, GUINT_TO_POINTER(
+                    MLX5_GET(delete_fte_in, in, flow_index)))) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+static void mlx5_tir_set_hash(MLX5Tir *tir, const uint8_t *tirc)
+{
+    const uint8_t *sel = MLX5_ADDR_OF(tirc, tirc,
+                                      rx_hash_field_selector_outer);
+
+    tir->hash_fn = MLX5_GET(tirc, tirc, rx_hash_fn);
+    tir->hash_symmetric = MLX5_GET(tirc, tirc, rx_hash_symmetric);
+    memcpy(tir->hash_key, MLX5_ADDR_OF(tirc, tirc, rx_hash_toeplitz_key),
+           sizeof(tir->hash_key));
+    tir->hash_l3_type = MLX5_GET(rx_hash_field_select, sel, l3_prot_type);
+    tir->hash_l4_type = MLX5_GET(rx_hash_field_select, sel, l4_prot_type);
+    tir->hash_fields = MLX5_GET(rx_hash_field_select, sel, selected_fields);
+}
+
+int mlx5_cmd_create_tir(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                        uint8_t *out, uint32_t outlen)
+{
+    const uint8_t *tirc;
+    MLX5Tir *tir;
+
+    MLX5_CMD_CHECK_LEN(create_tir_in, create_tir_out);
+    tirc = MLX5_ADDR_OF(create_tir_in, in, ctx);
+    tir = g_new0(MLX5Tir, 1);
+    tir->tirn = mlx5_alloc_id(s);
+    tir->indirect = MLX5_GET(tirc, tirc, disp_type) ==
+                    MLX5_TIRC_DISP_TYPE_INDIRECT;
+    tir->inline_rqn = MLX5_GET(tirc, tirc, inline_rqn);
+    tir->rqtn = MLX5_GET(tirc, tirc, indirect_table);
+    tir->self_lb = MLX5_GET(tirc, tirc, self_lb_block);
+    mlx5_tir_set_hash(tir, tirc);
+    g_hash_table_insert(s->tirs, GUINT_TO_POINTER(tir->tirn), tir);
+    trace_mlx5_tir(tir->tirn, tir->indirect,
+                   tir->indirect ? tir->rqtn : tir->inline_rqn, tir->hash_fn,
+                   tir->hash_fields);
+    MLX5_SET(create_tir_out, out, tirn, tir->tirn);
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_modify_tir(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                        uint8_t *out, uint32_t outlen)
+{
+    const uint8_t *tirc;
+    MLX5Tir *tir;
+
+    MLX5_CMD_CHECK_LEN(modify_tir_in, modify_tir_out);
+    tir = g_hash_table_lookup(s->tirs, GUINT_TO_POINTER(
+                                  MLX5_GET(modify_tir_in, in, tirn)));
+    if (!tir) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    tirc = MLX5_ADDR_OF(modify_tir_in, in, ctx);
+    if (MLX5_GET(modify_tir_in, in, bitmask.self_lb_en)) {
+        tir->self_lb = MLX5_GET(tirc, tirc, self_lb_block);
+    }
+    if (MLX5_GET(modify_tir_in, in, bitmask.hash)) {
+        mlx5_tir_set_hash(tir, tirc);
+        trace_mlx5_tir(tir->tirn, tir->indirect,
+                       tir->indirect ? tir->rqtn : tir->inline_rqn,
+                       tir->hash_fn, tir->hash_fields);
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_destroy_tir(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                         uint8_t *out, uint32_t outlen)
+{
+    MLX5_CMD_CHECK_LEN(destroy_tir_in, destroy_tir_out);
+    if (!g_hash_table_remove(s->tirs, GUINT_TO_POINTER(
+                                 MLX5_GET(destroy_tir_in, in, tirn)))) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+/*
+ * Classification
+ */
+
+/* Lay a frame's headers out the way flow table entries describe them. */
+static void mlx5_match_image(const uint8_t *buf, const MLX5PktInfo *pi,
+                             uint8_t *img)
+{
+    const uint8_t *ip = buf + pi->l3_off;
+    const uint8_t *l4h = buf + pi->l4_off;
+    uint16_t outer = lduw_be_p(buf + 12);
+
+    memset(img, 0, MLX5_MATCH_SIZE);
+    memcpy(MLX5_ADDR_OF(fte_match_set_lyr_2_4, img, dmac_47_16), buf,
+           ETH_ALEN);
+    memcpy(MLX5_ADDR_OF(fte_match_set_lyr_2_4, img, smac_47_16),
+           buf + ETH_ALEN, ETH_ALEN);
+    /* The type that follows any VLAN tags. */
+    MLX5_SET(fte_match_set_lyr_2_4, img, ethertype, pi->ethertype);
+    if (pi->l3_off > ETH_HLEN) {
+        uint16_t tci = lduw_be_p(buf + 14);
+
+        MLX5_SET(fte_match_set_lyr_2_4, img, cvlan_tag, outer == ETH_P_VLAN);
+        MLX5_SET(fte_match_set_lyr_2_4, img, svlan_tag, outer == ETH_P_DVLAN);
+        MLX5_SET(fte_match_set_lyr_2_4, img, first_prio, tci >> 13);
+        MLX5_SET(fte_match_set_lyr_2_4, img, first_cfi, (tci >> 12) & 1);
+        MLX5_SET(fte_match_set_lyr_2_4, img, first_vid, tci & 0xfff);
+    }
+
+    if (pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV4) {
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_version, 4);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ipv4_ihl, ip[0] & 0xf);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_dscp, ip[1] >> 2);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_ecn, ip[1] & 3);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ttl_hoplimit, ip[8]);
+        /* IPv4 addresses occupy the last four bytes of the address field. */
+        memcpy((uint8_t *)MLX5_ADDR_OF(fte_match_set_lyr_2_4, img,
+                                       src_ipv4_src_ipv6) + 12, ip + 12, 4);
+        memcpy((uint8_t *)MLX5_ADDR_OF(fte_match_set_lyr_2_4, img,
+                                       dst_ipv4_dst_ipv6) + 12, ip + 16, 4);
+    } else if (pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV6) {
+        uint8_t tclass = (lduw_be_p(ip) >> 4) & 0xff;
+
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_version, 6);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_dscp, tclass >> 2);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ip_ecn, tclass & 3);
+        MLX5_SET(fte_match_set_lyr_2_4, img, ttl_hoplimit, ip[7]);
+        memcpy(MLX5_ADDR_OF(fte_match_set_lyr_2_4, img, src_ipv4_src_ipv6),
+               ip + 8, 16);
+        memcpy(MLX5_ADDR_OF(fte_match_set_lyr_2_4, img, dst_ipv4_dst_ipv6),
+               ip + 24, 16);
+    } else {
+        return;
+    }
+    MLX5_SET(fte_match_set_lyr_2_4, img, ip_protocol, pi->ip_proto);
+    MLX5_SET(fte_match_set_lyr_2_4, img, frag, pi->fragment);
+
+    if (pi->l4_proto == IP_PROTO_TCP) {
+        MLX5_SET(fte_match_set_lyr_2_4, img, tcp_sport, lduw_be_p(l4h));
+        MLX5_SET(fte_match_set_lyr_2_4, img, tcp_dport, lduw_be_p(l4h + 2));
+        MLX5_SET(fte_match_set_lyr_2_4, img, tcp_flags,
+                 lduw_be_p(l4h + 12) & 0x1ff);
+    } else if (pi->l4_proto == IP_PROTO_UDP) {
+        MLX5_SET(fte_match_set_lyr_2_4, img, udp_sport, lduw_be_p(l4h));
+        MLX5_SET(fte_match_set_lyr_2_4, img, udp_dport, lduw_be_p(l4h + 2));
+    }
+}
+
+typedef struct MLX5FteLookup {
+    const MLX5FlowTable *ft;
+    const uint8_t *img;
+    const MLX5Fte *hit;
+} MLX5FteLookup;
+
+static gboolean mlx5_fte_match(gpointer key, gpointer value, gpointer data)
+{
+    MLX5FteLookup *lookup = data;
+    const MLX5Fte *fte = value;
+    const MLX5FlowGroup *fg = g_hash_table_lookup(
+        lookup->ft->groups, GUINT_TO_POINTER(fte->group_id));
+    unsigned sec, i;
+
+    if (!fg) {
+        return FALSE;
+    }
+    for (sec = 0; sec < MLX5_MATCH_SECTIONS; sec++) {
+        size_t off = sec * MLX5_MATCH_SECTION_SIZE;
+
+        if (!(fg->criteria_enable & (1u << sec))) {
+            continue;
+        }
+        for (i = 0; i < MLX5_MATCH_SECTION_SIZE; i++) {
+            if ((lookup->img[off + i] ^ fte->value[off + i]) &
+                fg->mask[off + i]) {
+                return FALSE;
+            }
+        }
+    }
+    lookup->hit = fte;
+    return TRUE;    /* stop: entries are visited in index order */
+}
+
+static uint32_t mlx5_toeplitz(const uint8_t *key, size_t key_len,
+                              const uint8_t *data, size_t len)
+{
+    uint32_t window = ldl_be_p(key);
+    uint32_t hash = 0;
+    size_t i;
+    int bit;
+
+    for (i = 0; i < len; i++) {
+        for (bit = 7; bit >= 0; bit--) {
+            if (data[i] & (1 << bit)) {
+                hash ^= window;
+            }
+            window <<= 1;
+            if (i + 4 < key_len && (key[i + 4] & (1 << bit))) {
+                window |= 1;
+            }
+        }
+    }
+    return hash;
+}
+
+/* Append a (source, destination) pair of hash fields. */
+static size_t mlx5_hash_pair(uint8_t *in, const uint8_t *src,
+                             const uint8_t *dst, size_t len, bool want_src,
+                             bool want_dst, bool symmetric)
+{
+    size_t n = 0, i;
+
+    if (symmetric && want_src && want_dst) {
+        /* Direction independent: OR of the pair, then XOR of the pair. */
+        for (i = 0; i < len; i++) {
+            in[i] = src[i] | dst[i];
+            in[len + i] = src[i] ^ dst[i];
+        }
+        return 2 * len;
+    }
+    if (want_src) {
+        memcpy(in, src, len);
+        n += len;
+    }
+    if (want_dst) {
+        memcpy(in + n, dst, len);
+        n += len;
+    }
+    return n;
+}
+
+/* RSS hash of the fields a TIR selects, where the frame has them. */
+static uint32_t mlx5_tir_hash(const MLX5Tir *tir, const uint8_t *buf,
+                              const MLX5PktInfo *pi, uint8_t *hash_type)
+{
+    const uint8_t *ip = buf + pi->l3_off;
+    const uint8_t *l4h = buf + pi->l4_off;
+    bool v6 = pi->l3_type == MLX5_CQE_L3_HDR_TYPE_IPV6;
+    uint32_t fields = tir->hash_fields;
+    uint8_t in[2 * 16 + 2 * 2];
+    size_t len = 0;
+    unsigned i;
+    uint8_t x;
+
+    *hash_type = 0;
+    if (tir->hash_fn == MLX5_RX_HASH_FN_NONE || !pi->l3_type ||
+        v6 != (tir->hash_l3_type == MLX5_L3_PROT_TYPE_IPV6)) {
+        return 0;
+    }
+    if (fields & (MLX5_HASH_FIELD_SEL_SRC_IP | MLX5_HASH_FIELD_SEL_DST_IP)) {
+        len += mlx5_hash_pair(in, ip + (v6 ? 8 : 12), ip + (v6 ? 24 : 16),
+                              v6 ? 16 : 4,
+                              fields & MLX5_HASH_FIELD_SEL_SRC_IP,
+                              fields & MLX5_HASH_FIELD_SEL_DST_IP,
+                              tir->hash_symmetric);
+        *hash_type |= v6 ? MLX5_CQE_RSS_IPV6 : MLX5_CQE_RSS_IPV4;
+    }
+    if ((fields & (MLX5_HASH_FIELD_SEL_L4_SPORT |
+                   MLX5_HASH_FIELD_SEL_L4_DPORT)) &&
+        pi->l4_proto == (tir->hash_l4_type == MLX5_L4_PROT_TYPE_UDP ?
+                         IP_PROTO_UDP : IP_PROTO_TCP)) {
+        len += mlx5_hash_pair(in + len, l4h, l4h + 2, 2,
+                              fields & MLX5_HASH_FIELD_SEL_L4_SPORT,
+                              fields & MLX5_HASH_FIELD_SEL_L4_DPORT,
+                              tir->hash_symmetric);
+        *hash_type |= pi->l4_proto == IP_PROTO_UDP ? MLX5_CQE_RSS_L4_UDP :
+                                                     MLX5_CQE_RSS_L4_TCP;
+    }
+
+    if (tir->hash_fn == MLX5_RX_HASH_FN_TOEPLITZ) {
+        return mlx5_toeplitz(tir->hash_key, sizeof(tir->hash_key), in, len);
+    }
+    for (x = 0, i = 0; i < len; i++) {
+        x ^= in[i];
+    }
+    return (uint8_t)~x;
+}
+
+static void mlx5_tir_target(MLX5State *s, uint32_t tirn, uint32_t flow_tag,
+                            const uint8_t *buf, const MLX5PktInfo *pi,
+                            MLX5RxTarget *targets, unsigned *n)
+{
+    const MLX5Tir *tir = g_hash_table_lookup(s->tirs,
+                                             GUINT_TO_POINTER(tirn));
+    MLX5RxTarget *t;
+
+    if (!tir || *n >= MLX5_RX_MAX_TARGETS) {
+        return;
+    }
+    t = &targets[*n];
+    t->flow_tag = flow_tag;
+    t->hash = mlx5_tir_hash(tir, buf, pi, &t->hash_type);
+    if (tir->indirect) {
+        const MLX5Rqt *rqt = g_hash_table_lookup(s->rqts,
+                                                 GUINT_TO_POINTER(tir->rqtn));
+
+        if (!rqt || !rqt->size) {
+            return;
+        }
+        t->rqn = rqt->rqns[t->hash % rqt->size];
+    } else {
+        t->rqn = tir->inline_rqn;
+    }
+    (*n)++;
+}
+
+static void mlx5_fs_walk(MLX5State *s, uint32_t table_id, const uint8_t *img,
+                         const uint8_t *buf, const MLX5PktInfo *pi,
+                         MLX5RxTarget *targets, unsigned *n, unsigned depth)
+{
+    while (depth++ < MLX5_FS_MAX_DEPTH) {
+        MLX5FteLookup lookup = { .img = img };
+        const MLX5Fte *fte;
+        uint32_t i;
+
+        lookup.ft = mlx5_flow_table_get(s, table_id);
+        if (!lookup.ft) {
+            return;
+        }
+        g_tree_foreach(lookup.ft->ftes, mlx5_fte_match, &lookup);
+        fte = lookup.hit;
+        trace_mlx5_fs_lookup(table_id, fte != NULL, fte ? fte->action : 0);
+
+        if (!fte || !(fte->action & (MLX5_FLOW_CONTEXT_ACTION_DROP |
+                                     MLX5_FLOW_CONTEXT_ACTION_FWD_DEST))) {
+            if (!lookup.ft->miss_fwd) {
+                return;
+            }
+            table_id = lookup.ft->miss_table_id;
+            continue;
+        }
+        if (fte->action & MLX5_FLOW_CONTEXT_ACTION_DROP) {
+            return;
+        }
+        for (i = 0; i < fte->ndests; i++) {
+            switch (fte->dests[i].type) {
+            case MLX5_IFC_FLOW_DESTINATION_TYPE_TIR:
+                mlx5_tir_target(s, fte->dests[i].id, fte->flow_tag, buf, pi,
+                                targets, n);
+                break;
+            case MLX5_IFC_FLOW_DESTINATION_TYPE_FLOW_TABLE:
+                mlx5_fs_walk(s, fte->dests[i].id, img, buf, pi, targets, n,
+                             depth);
+                break;
+            default:
+                break;
+            }
+        }
+        return;
+    }
+}
+
+/*
+ * Find the receive queues a frame goes to.  Returns false if the driver has
+ * not set up receive steering at all.
+ */
+bool mlx5_fs_classify(MLX5State *s, const uint8_t *buf,
+                      const MLX5PktInfo *pi, MLX5RxTarget *targets,
+                      unsigned *n)
+{
+    uint8_t img[MLX5_MATCH_SIZE];
+
+    *n = 0;
+    if (!s->rx_root_valid) {
+        return false;
+    }
+    mlx5_match_image(buf, pi, img);
+    mlx5_fs_walk(s, s->rx_root_ft, img, buf, pi, targets, n, 0);
+    return true;
+}
+
+/* Self-loopback flags (MLX5_TIRC_SELF_LB_BLOCK_*) enabled on any TIR. */
+unsigned mlx5_fs_self_lb(MLX5State *s)
+{
+    GHashTableIter iter;
+    gpointer value;
+    unsigned flags = 0;
+
+    g_hash_table_iter_init(&iter, s->tirs);
+    while (g_hash_table_iter_next(&iter, NULL, &value)) {
+        flags |= ((MLX5Tir *)value)->self_lb;
+    }
+    return flags;
+}
+
+void mlx5_fs_reset(MLX5State *s)
+{
+    g_hash_table_remove_all(s->flow_tables);
+    g_hash_table_remove_all(s->tirs);
+    s->rx_root_valid = false;
+}
+
+void mlx5_fs_init(MLX5State *s)
+{
+    s->flow_tables = g_hash_table_new_full(NULL, NULL, NULL,
+                                           mlx5_flow_table_free);
+    s->tirs = g_hash_table_new_full(NULL, NULL, NULL, g_free);
+}
+
+void mlx5_fs_cleanup(MLX5State *s)
+{
+    g_hash_table_destroy(s->flow_tables);
+    g_hash_table_destroy(s->tirs);
+}
