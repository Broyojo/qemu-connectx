+void mlx5_fs_init(MLX5State *s);
+void mlx5_fs_cleanup(MLX5State *s);
 
 /* mlx5_dp.c */
 void mlx5_eq_post(MLX5State *s, MLX5Eq *eq, uint8_t type, uint8_t sub_type,
@@ -174,5 +276,7 @@ void mlx5_cq_doorbell(MLX5State *s, uint32_t cmd_ci, uint32_t cqn);
