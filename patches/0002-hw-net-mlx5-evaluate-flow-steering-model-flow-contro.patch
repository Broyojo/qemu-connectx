@@ -90,9 +90,25 @@ MemTxResult mlx5_buf_rw(MLX5State *s, const MLX5Buf *buf, uint64_t off,
     return MEMTX_OK;
 }
 
+static void mlx5_rx_retry_timer(void *opaque)
+{
+    mlx5_rx_retry(opaque);
+}
+
+static void mlx5_tx_retry_timer(void *opaque)
+{
+    mlx5_tx_resume(opaque);
+}
+
 static void mlx5_reset(MLX5State *s)
 {
     mlx5_cmd_reset(s);
+    timer_del(s->tx_retry_timer);
+    s->tx_paused = false;
+    /* Frames held back for a stalled receive queue are dropped now. */
+    timer_del(s->rx_retry_timer);
+    s->rx_stalled = false;
+    qemu_flush_queued_packets(qemu_get_queue(s->nic));
     s->cmdq_addr = 0;
     s->nic_ifc = MLX5_NIC_IFC_FULL;
     s->db_latch = 0;
@@ -184,6 +200,14 @@ static void mlx5_uar_write(MLX5State *s, hwaddr addr, uint64_t val,
 {
     hwaddr off = addr & (MLX5_UAR_PAGE_SIZE - 1);
 
+    /*
+     * The driver refills receive queues without telling the device, but
+     * it rings some doorbell soon after: a good moment to retry.
+     */
+    if (s->rx_stalled) {
+        mlx5_rx_retry(s);
+    }
+
     if (size == 4) {
         if (off == MLX5_UAR_EQ_DOORBELL_ARM || off == MLX5_UAR_EQ_DOORBELL) {
             mlx5_eq_doorbell(s, val, off == MLX5_UAR_EQ_DOORBELL_ARM);
@@ -322,6 +346,10 @@ static void mlx5_realize(PCIDevice *pci_dev, Error **errp)
                           DEVICE(s)->id, &DEVICE(s)->mem_reentrancy_guard, s);
     qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
 
+    s->rx_retry_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mlx5_rx_retry_timer,
+                                     s);
+    s->tx_retry_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mlx5_tx_retry_timer,
+                                     s);
     s->tx_buf = g_malloc(MLX5_MAX_TX_PKT);
     s->seg_buf = g_malloc(MLX5_MAX_LSO_HEADER + UINT16_MAX);
     s->rx_buf = g_malloc(MLX5_MAX_FRAME);
@@ -332,6 +360,8 @@ static void mlx5_exit(PCIDevice *pci_dev)
 {
     MLX5State *s = MLX5(pci_dev);
 
+    timer_free(s->rx_retry_timer);
+    timer_free(s->tx_retry_timer);
     mlx5_cmd_cleanup(s);
     g_free(s->tx_buf);
     g_free(s->seg_buf);
