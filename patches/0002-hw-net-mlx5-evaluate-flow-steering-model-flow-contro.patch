+
+/*
+ * With flow control on, a frame that finds its receive queue empty is held
+ * back and retried, as if the port had paused its link partner.  After this
+ * long without buffers the port gives up and drops instead.  A port whose
+ * link partner cannot take frames stops sending and checks again later.
+ */
+#define MLX5_RX_STALL_NS            (500 * SCALE_MS)
+#define MLX5_RX_RETRY_NS            (100 * SCALE_US)
 /* Port MTU as the driver counts it: including the Ethernet header and FCS. */
 #define MLX5_MAX_MTU                10240
 #define MLX5_MAX_FRAME              MLX5_MAX_MTU
@@ -94,6 +103,42 @@ typedef struct MLX5Rqt {
     uint32_t *rqns;
 } MLX5Rqt;
 
+/* Transport interface receive: maps classified frames to receive queues. */
+typedef struct MLX5Tir {
+    uint32_t tirn;
+    bool indirect;          /* through an RQ table rather than one RQ */
+    uint32_t inline_rqn;
+    uint32_t rqtn;
+    uint8_t hash_fn;
+    bool hash_symmetric;
+    uint8_t hash_key[40];
+    uint8_t hash_l3_type;
+    uint8_t hash_l4_type;
+    uint32_t hash_fields;
+    uint8_t self_lb;
+} MLX5Tir;
+
+/* What the device needs to know about a frame's headers. */
+typedef struct MLX5PktInfo {
+    uint16_t ethertype;     /* after any VLAN tags */
+    uint16_t l3_off;
+    uint16_t l4_off;
+    uint8_t l3_type;        /* MLX5_CQE_L3_HDR_TYPE_* */
+    uint8_t ip_proto;
+    uint8_t l4_proto;       /* IP_PROTO_TCP or IP_PROTO_UDP, else 0 */
+    bool fragment;
+} MLX5PktInfo;
+
+/* Where flow steering sends a frame. */
+typedef struct MLX5RxTarget {
+    uint32_t rqn;
+    uint32_t hash;
+    uint8_t hash_type;      /* MLX5_CQE_RSS_* */
+    uint32_t flow_tag;
+} MLX5RxTarget;
