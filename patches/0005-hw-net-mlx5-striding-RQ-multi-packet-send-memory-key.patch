@@ -0,0 +1,272 @@
+/*
+ * Mellanox ConnectX (mlx5) emulation: memory keys
+ *
+ * Every address in a work queue entry comes with a memory key that says how
+ * to interpret it:
+ *
+ *  - PA:  the address is a bus address.
+ *  - MTT: the address indexes a table of equally sized pages.
+ *  - KSM: like MTT, but each table entry points into another memory key.
+ *  - KLM: like KSM with a length per entry.
+ *
+ * The driver creates the tables with CREATE_MKEY and rewrites parts of them
+ * at run time with UMR work queue entries, which is how it rotates fresh
+ * pages into a striding receive queue without issuing commands.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "mlx5.h"
+#include "../trace.h"
+
+#define MLX5_OCTWORD            16
+#define MLX5_MKEY_MAX_DEPTH     4
+
+/* Read and write permission bits in the low bits of an MTT entry. */
+#define MLX5_MTT_ADDR_MASK      (~0x3ull)
+
+static void mlx5_mkey_free(gpointer data)
+{
+    MLX5Mkey *mkey = data;
+
+    g_free(mkey->xlt);
+    g_free(mkey);
+}
+
+static MLX5Mkey *mlx5_mkey_get(MLX5State *s, uint32_t key)
+{
+    /* The low byte is a variant chosen by the driver, not part of the index. */
+    return g_hash_table_lookup(s->mkeys, GUINT_TO_POINTER(key >> 8));
+}
+
+int mlx5_cmd_create_mkey(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                         uint8_t *out, uint32_t outlen)
+{
+    const uint8_t *mkc, *xlt;
+    uint64_t actual;
+    MLX5Mkey *mkey;
+
+    MLX5_CMD_CHECK_LEN(create_mkey_in, create_mkey_out);
+    mkc = MLX5_ADDR_OF(create_mkey_in, in, memory_key_mkey_entry);
+    xlt = MLX5_ADDR_OF(create_mkey_in, in, klm_pas_mtt);
+
+    mkey = g_new0(MLX5Mkey, 1);
+    mkey->access_mode = MLX5_GET(mkc, mkc, access_mode_4_2) << 2 |
+                        MLX5_GET(mkc, mkc, access_mode_1_0);
+    mkey->free = MLX5_GET(mkc, mkc, free);
+    mkey->start_addr = MLX5_GET64(mkc, mkc, start_addr);
+    mkey->len = MLX5_GET64(mkc, mkc, len);
+    mkey->log_page_size = MLX5_GET(mkc, mkc, log_page_size);
+    mkey->xlt_size = (uint64_t)MLX5_GET(mkc, mkc, translations_octword_size) *
+                     MLX5_OCTWORD;
+    actual = (uint64_t)MLX5_GET(create_mkey_in, in,
+                                translations_octword_actual_size) *
+             MLX5_OCTWORD;
+    if (mkey->xlt_size > MLX5_CMD_MAX_LEN || actual > mkey->xlt_size ||
+        actual > in + inlen - xlt) {
+        g_free(mkey);
+        return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
+    }
+    mkey->xlt = g_malloc0(mkey->xlt_size);
+    memcpy(mkey->xlt, xlt, actual);
+
+    mkey->index = mlx5_alloc_id(s);
+    g_hash_table_insert(s->mkeys, GUINT_TO_POINTER(mkey->index), mkey);
+    trace_mlx5_create_mkey(mkey->index, mkey->access_mode, mkey->free,
+                           mkey->len, mkey->log_page_size, mkey->xlt_size);
+    MLX5_SET(create_mkey_out, out, mkey_index, mkey->index);
+    return MLX5_CMD_STAT_OK;
+}
+
+int mlx5_cmd_destroy_mkey(MLX5State *s, const uint8_t *in, uint32_t inlen,
+                          uint8_t *out, uint32_t outlen)
+{
+    MLX5_CMD_CHECK_LEN(destroy_mkey_in, destroy_mkey_out);
+    if (!g_hash_table_remove(s->mkeys, GUINT_TO_POINTER(
+                                 MLX5_GET(destroy_mkey_in, in, mkey_index)))) {
+        return MLX5_CMD_STAT_BAD_RES_ERR;
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+static MemTxResult mlx5_mkey_rw_depth(MLX5State *s, uint32_t key, uint64_t va,
+                                      void *buf, uint64_t len, bool is_write,
+                                      unsigned depth)
+{
+    const MLX5Mkey *mkey = mlx5_mkey_get(s, key);
+    uint64_t off, size, idx, in_ent, n;
+    uint8_t *p = buf;
+    const uint8_t *e;
+    MemTxResult res;
+
+    if (!mkey || mkey->free || depth > MLX5_MKEY_MAX_DEPTH) {
+        return MEMTX_DECODE_ERROR;
+    }
+    if (mkey->access_mode == MLX5_MKC_ACCESS_MODE_PA) {
+        return pci_dma_rw(PCI_DEVICE(s), va, buf, len,
+                          is_write ? DMA_DIRECTION_FROM_DEVICE :
+                                     DMA_DIRECTION_TO_DEVICE,
+                          MEMTXATTRS_UNSPECIFIED);
+    }
+
+    off = va - mkey->start_addr;
+    size = 1ull << mkey->log_page_size;
+    while (len) {
+        switch (mkey->access_mode) {
+        case MLX5_MKC_ACCESS_MODE_MTT:
+            idx = off >> mkey->log_page_size;
+            in_ent = off & (size - 1);
+            n = MIN(len, size - in_ent);
+            if ((idx + 1) * 8 > mkey->xlt_size) {
+                return MEMTX_DECODE_ERROR;
+            }
+            res = pci_dma_rw(PCI_DEVICE(s),
+                             (ldq_be_p(mkey->xlt + idx * 8) &
+                              MLX5_MTT_ADDR_MASK) + in_ent, p, n,
+                             is_write ? DMA_DIRECTION_FROM_DEVICE :
+                                        DMA_DIRECTION_TO_DEVICE,
+                             MEMTXATTRS_UNSPECIFIED);
+            break;
+
+        case MLX5_MKC_ACCESS_MODE_KSM:
+            /* Entries: reserved word, key, 64-bit address. */
+            idx = off >> mkey->log_page_size;
+            in_ent = off & (size - 1);
+            n = MIN(len, size - in_ent);
+            if ((idx + 1) * MLX5_OCTWORD > mkey->xlt_size) {
+                return MEMTX_DECODE_ERROR;
+            }
+            e = mkey->xlt + idx * MLX5_OCTWORD;
+            res = mlx5_mkey_rw_depth(s, ldl_be_p(e + 4),
+                                     ldq_be_p(e + 8) + in_ent, p, n, is_write,
+                                     depth + 1);
+            break;
+
+        case MLX5_MKC_ACCESS_MODE_KLMS:
+            /* Entries: byte count, key, 64-bit address.  Find ours. */
+            in_ent = off;
+            for (idx = 0; ; idx++) {
+                if ((idx + 1) * MLX5_OCTWORD > mkey->xlt_size) {
+                    return MEMTX_DECODE_ERROR;
+                }
+                e = mkey->xlt + idx * MLX5_OCTWORD;
+                if (in_ent < ldl_be_p(e)) {
+                    break;
+                }
+                in_ent -= ldl_be_p(e);
+            }
+            n = MIN(len, ldl_be_p(e) - in_ent);
+            res = mlx5_mkey_rw_depth(s, ldl_be_p(e + 4),
+                                     ldq_be_p(e + 8) + in_ent, p, n, is_write,
+                                     depth + 1);
+            break;
+
+        default:
+            return MEMTX_DECODE_ERROR;
+        }
+        if (res != MEMTX_OK) {
+            return res;
+        }
+        p += n;
+        off += n;
+        len -= n;
+    }
+    return MEMTX_OK;
+}
+
+/* Read or write guest memory at an address qualified by a memory key. */
+MemTxResult mlx5_mkey_rw(MLX5State *s, uint32_t key, uint64_t va, void *buf,
+                         uint64_t len, bool is_write)
+{
+    return mlx5_mkey_rw_depth(s, key, va, buf, len, is_write, 0);
+}
+
+/*
+ * UMR work queue entry: update a memory key from a send queue.  After the
+ * control segment come a UMR control segment (what to change), a memory key
+ * segment (new attribute values) and the new translation entries, inline or
+ * as a pointer to them.
+ */
+void mlx5_mkey_umr(MLX5State *s, const uint8_t *wqe, size_t wqe_len)
+{
+    const struct mlx5_wqe_ctrl_seg *ctrl = (const void *)wqe;
+    const struct mlx5_wqe_umr_ctrl_seg *uctrl = (const void *)(ctrl + 1);
+    const struct mlx5_mkey_seg *mkseg = (const void *)(uctrl + 1);
+    const uint8_t *data = (const void *)(mkseg + 1);
+    uint64_t mask, bytes, off;
+    MLX5Mkey *mkey;
+
+    if (wqe_len < data - wqe) {
+        goto bad;
+    }
+    mkey = mlx5_mkey_get(s, be32_to_cpu(ctrl->imm));
+    if (!mkey) {
+        goto bad;
+    }
+    mask = be64_to_cpu(uctrl->mkey_mask);
+    bytes = (uint64_t)be16_to_cpu(uctrl->xlt_octowords) * MLX5_OCTWORD;
+    off = be16_to_cpu(uctrl->xlt_offset);
+    if (uctrl->flags & MLX5_UMR_TRANSLATION_OFFSET_EN) {
+        off |= (uint64_t)be32_to_cpu(uctrl->xlt_offset_47_16) << 16;
+    } else {
+        off = 0;
+    }
+    off *= MLX5_OCTWORD;
+
+    if (bytes) {
+        if (off + bytes > mkey->xlt_size) {
+            goto bad;
+        }
+        if (uctrl->flags & MLX5_UMR_INLINE) {
+            if (bytes > wqe + wqe_len - data) {
+                goto bad;
+            }
+            memcpy(mkey->xlt + off, data, bytes);
+        } else {
+            const struct mlx5_wqe_data_seg *dseg = (const void *)data;
+
+            if (sizeof(*dseg) > wqe + wqe_len - data ||
+                mlx5_mkey_rw(s, be32_to_cpu(dseg->lkey),
+                             be64_to_cpu(dseg->addr), mkey->xlt + off, bytes,
+                             false) != MEMTX_OK) {
+                goto bad;
+            }
+        }
+    }
+
+    if (mask & MLX5_MKEY_MASK_FREE) {
+        mkey->free = mkseg->status & MLX5_MKEY_STATUS_FREE;
+    }
+    if (mask & MLX5_MKEY_MASK_LEN) {
+        mkey->len = be64_to_cpu(mkseg->len);
+    }
+    if (mask & MLX5_MKEY_MASK_START_ADDR) {
+        mkey->start_addr = be64_to_cpu(mkseg->start_addr);
+    }
+    if (mask & MLX5_MKEY_MASK_PAGE_SIZE) {
+        mkey->log_page_size = mkseg->log2_page_size;
+    }
+    trace_mlx5_umr(mkey->index, off, bytes, mkey->free);
+    return;
+
+bad:
+    qemu_log_mask(LOG_GUEST_ERROR, "mlx5: malformed UMR WQE\n");
+}
+
+void mlx5_mkey_reset(MLX5State *s)
+{
+    g_hash_table_remove_all(s->mkeys);
+}
+
+void mlx5_mkey_init(MLX5State *s)
+{
+    s->mkeys = g_hash_table_new_full(NULL, NULL, NULL, mlx5_mkey_free);
+}
+
+void mlx5_mkey_cleanup(MLX5State *s)
+{
+    g_hash_table_destroy(s->mkeys);
+}
diff --git a/hw/net/mlx5/mlx5_reg.c b/hw/net/mlx5/mlx5_reg.c
new file mode 100644
index 0000000..793248c
--- /dev/null
+++ b/hw/net/mlx5/mlx5_reg.c
@@ -0,0 +1,521 @@
+/*
+ * Mellanox ConnectX (mlx5) emulation: port and management registers
+ *
+ * The ACCESS_REG command reads and writes registers that describe the port
+ * (MTU, link modes, FEC, flow control, counters), the cable plugged into it,
+ * and the board (firmware components, temperature).  Two of them, PCAM and
+ * MCAM, are masks of which other registers and features exist.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "mlx5.h"
+#include "../trace.h"
+
+/* FEC modes, as bits in the PPLM register's fields */
+#define MLX5_FEC_NONE           (1 << 0)
+#define MLX5_FEC_FIRECODE       (1 << 1)
+#define MLX5_FEC_RS             (1 << 2)
+
+/* PTYS values */
+#define MLX5_PTYS_AN_COMPLETE   1
+#define MLX5_PTYS_CONNECTOR_DA  7       /* direct attach copper */
+
+/* MCQS/MCQI: the one firmware component is the boot image */
+#define MLX5_MCQS_IDENTIFIER_BOOT_IMG   1
+#define MLX5_MCQI_INFO_TYPE_VERSION     1
+
+/* Temperatures are in units of 1/8 degree Celsius. */
+#define MLX5_MTMP_DEG(c)        ((c) * 8)
+
+/*
+ * Link modes of a ConnectX-5, by bit in the PTYS register's protocol masks.
+ * The first entry of each speed is the one reported as operational: the
+ * modelled cable is a passive copper one.
+ */
+static const struct {
+    uint8_t bit;
+    uint32_t speed;
+} mlx5_link_modes[] = {
+    { 20, 100000 },     /* 100GBASE-CR4 */
+    { 21, 100000 },     /* 100GBASE-SR4 */
+    { 22, 100000 },     /* 100GBASE-KR4 */
+    { 23, 100000 },     /* 100GBASE-LR4 */
+    { 30, 50000 },      /* 50GBASE-CR2 */
+    { 31, 50000 },      /* 50GBASE-KR2 */
+    { 18, 50000 },      /* 50GBASE-SR2 */
+    { 6, 40000 },       /* 40GBASE-CR4 */
+    { 7, 40000 },       /* 40GBASE-KR4 */
+    { 15, 40000 },      /* 40GBASE-SR4 */
+    { 16, 40000 },      /* 40GBASE-LR4 */
+    { 27, 25000 },      /* 25GBASE-CR */
+    { 28, 25000 },      /* 25GBASE-KR */
+    { 29, 25000 },      /* 25GBASE-SR */
+    { 12, 10000 },      /* 10GBASE-CR */
+    { 4, 10000 },       /* 10GBASE-KR */
+    { 13, 10000 },      /* 10GBASE-SR */
+    { 1, 1000 },        /* 1000BASE-KX */
+};
+
+/* Everything up to the speed the port was configured with. */
+static uint32_t mlx5_proto_cap(MLX5State *s)
+{
+    uint32_t mask = 0;
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(mlx5_link_modes); i++) {
+        if (mlx5_link_modes[i].speed <= s->link_speed) {
+            mask |= 1u << mlx5_link_modes[i].bit;
+        }
+    }
+    /* An unlisted speed property still has to yield a usable port. */
+    return mask ?: 1u << mlx5_link_modes[0].bit;
+}
+
+static uint32_t mlx5_proto_admin(MLX5State *s)
+{
+    uint32_t cap = mlx5_proto_cap(s);
+
+    return s->ptys_admin & cap ?: cap;
+}
+
+/* The fastest mode both "sides" allow; the table is sorted by speed. */
+static uint32_t mlx5_proto_oper(MLX5State *s, uint32_t *speed)
+{
+    uint32_t admin = mlx5_proto_admin(s);
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(mlx5_link_modes); i++) {
+        if (admin & (1u << mlx5_link_modes[i].bit)) {
+            *speed = mlx5_link_modes[i].speed;
+            return 1u << mlx5_link_modes[i].bit;
+        }
+    }
+    *speed = 0;
+    return 0;
+}
+
+static int mlx5_reg_ptys(MLX5State *s, bool write, uint8_t *data)
+{
+    uint32_t speed;
+    uint32_t oper = mlx5_proto_oper(s, &speed);
+
+    if (write) {
+        s->ptys_admin = MLX5_GET(ptys_reg, data, eth_proto_admin);
+        s->an_disable = MLX5_GET(ptys_reg, data, an_disable_admin);
+        if (mlx5_proto_oper(s, &speed) != oper && mlx5_link_up(s)) {
+            /* The link retrains at the new speed. */
+            mlx5_port_event(s);
+        }
+        return MLX5_CMD_STAT_OK;
+    }
+    MLX5_SET(ptys_reg, data, an_disable_cap, 1);
+    MLX5_SET(ptys_reg, data, an_disable_admin, s->an_disable);
+    MLX5_SET(ptys_reg, data, an_status, MLX5_PTYS_AN_COMPLETE);
+    MLX5_SET(ptys_reg, data, connector_type, MLX5_PTYS_CONNECTOR_DA);
+    MLX5_SET(ptys_reg, data, eth_proto_capability, mlx5_proto_cap(s));
+    MLX5_SET(ptys_reg, data, eth_proto_admin, mlx5_proto_admin(s));
+    if (mlx5_link_up(s)) {
+        MLX5_SET(ptys_reg, data, eth_proto_oper, oper);
+        /* The link partner is taken to offer whatever we do. */
+        MLX5_SET(ptys_reg, data, eth_proto_lp_advertise,
+                 mlx5_proto_admin(s));
+    }
+    return MLX5_CMD_STAT_OK;
+}
+
+/* Forward error correction: what each speed class can do, and what is on. */
+static int mlx5_reg_pplm(MLX5State *s, bool write, uint8_t *data)
+{
+    uint32_t speed, admin, active;
+
+    if (write) {
+        memcpy(s->pplm, data, sizeof(s->pplm));
+        return MLX5_CMD_STAT_OK;
+    }
+    memcpy(data, s->pplm, sizeof(s->pplm));
+    MLX5_SET(pplm_reg, data, local_port, 1);
+    MLX5_SET(pplm_reg, data, fec_override_cap_10g_40g,
+             MLX5_FEC_NONE | MLX5_FEC_FIRECODE);
+    MLX5_SET(pplm_reg, data, fec_override_cap_25g,
+             MLX5_FEC_NONE | MLX5_FEC_FIRECODE | MLX5_FEC_RS);
+    MLX5_SET(pplm_reg, data, fec_override_cap_50g,
+             MLX5_FEC_NONE | MLX5_FEC_FIRECODE | MLX5_FEC_RS);
+    MLX5_SET(pplm_reg, data, fec_override_cap_100g,
+             MLX5_FEC_NONE | MLX5_FEC_RS);
+
+    /* Zero in an "admin" field means automatic selection. */
+    mlx5_proto_oper(s, &speed);
+    switch (speed) {
+    case 100000:
+        admin = MLX5_GET(pplm_reg, data, fec_override_admin_100g);
+        active = MLX5_FEC_RS;
+        break;
+    case 50000:
+        admin = MLX5_GET(pplm_reg, data, fec_override_admin_50g);
+        active = MLX5_FEC_RS;
+        break;
+    case 25000:
+        admin = MLX5_GET(pplm_reg, data, fec_override_admin_25g);
+        active = MLX5_FEC_RS;
+        break;
+    default:
+        admin = MLX5_GET(pplm_reg, data, fec_override_admin_10g_40g);
+        active = MLX5_FEC_NONE;
+        break;
+    }
+    if (admin) {
+        active = admin & MLX5_FEC_RS ?: admin & MLX5_FEC_FIRECODE ?:
+                 MLX5_FEC_NONE;
+    }
+    MLX5_SET(pplm_reg, data, fec_mode_active, mlx5_link_up(s) ? active : 0);
+    return MLX5_CMD_STAT_OK;
+}
+
+#define PPCNT_SET(data, fld, val)                                           \
+    do {                                                                    \
+        MLX5_SET(ppcnt_reg, data,                                           \
+                 counter_set.eth_802_3_cntrs_grp_data_layout.fld ## _high,  \
+                 (val) >> 32);                                              \
+        MLX5_SET(ppcnt_reg, data,                                           \
+                 counter_set.eth_802_3_cntrs_grp_data_layout.fld ## _low,   \
+                 (val));                                                    \
+    } while (0)
+
+/* Port counters.  Only the IEEE 802.3 group has anything to report. */
+static void mlx5_reg_ppcnt(MLX5State *s, uint8_t *data)
+{
+    MLX5Stats *st = &s->stats;
+
+    if (MLX5_GET(ppcnt_reg, data, grp) != MLX5_IEEE_802_3_COUNTERS_GROUP) {
+        return;
+    }
+    PPCNT_SET(data, a_frames_transmitted_ok, st->tx_packets);
+    PPCNT_SET(data, a_frames_received_ok, st->rx_phy_packets);
+    PPCNT_SET(data, a_octets_transmitted_ok, st->tx_bytes);
+    PPCNT_SET(data, a_octets_received_ok, st->rx_phy_bytes);
+    PPCNT_SET(data, a_multicast_frames_xmitted_ok, st->tx_mcast_packets);
+    PPCNT_SET(data, a_broadcast_frames_xmitted_ok, st->tx_bcast_packets);
+    PPCNT_SET(data, a_multicast_frames_received_ok, st->rx_mcast_packets);
+    PPCNT_SET(data, a_broadcast_frames_received_ok, st->rx_bcast_packets);
+}
+
+/* Pad or cut a string to fill a fixed-width, space-padded EEPROM field. */
+static void mlx5_eeprom_str(uint8_t *field, size_t len, const char *str)
+{
+    size_t n = MIN(len, strlen(str));
+
+    memset(field, ' ', len);
+    memcpy(field, str, n);
+}
+
+static uint8_t mlx5_eeprom_sum(const uint8_t *eeprom, size_t first,
+                               size_t last)
+{
+    uint8_t sum = 0;
+
+    while (first <= last) {
+        sum += eeprom[first++];
+    }
+    return sum;
+}
+
+/*
+ * The cable: page 0 of the SFF-8636 memory map of a one metre QSFP28
+ * passive copper cable, which is all a flat-memory module has.
+ */
+static void mlx5_module_eeprom(MLX5State *s, uint8_t *eeprom)
+{
+    char serial[17];
+
+    memset(eeprom, 0, 256);
+    eeprom[0] = 0x11;           /* identifier: QSFP28 */
+    eeprom[1] = 0x07;           /* revision: SFF-8636 2.7 */
+    eeprom[2] = 0x04;           /* flat memory: no pages beyond this one */
+
+    eeprom[128] = 0x11;         /* identifier again */
+    eeprom[130] = 0x23;         /* connector: no separable connector */
+    eeprom[131] = 0x80;         /* compliance: see extended code */
+    eeprom[140] = 0xff;         /* nominal bit rate: see byte 222 */
+    eeprom[146] = 1;            /* copper length, metres */
+    eeprom[147] = 0xa0;         /* technology: passive copper, unequalized */
+    mlx5_eeprom_str(eeprom + 148, 16, "QEMU");
+    mlx5_eeprom_str(eeprom + 168, 16, "MLX5-DAC-1M");
+    mlx5_eeprom_str(eeprom + 184, 2, "A1");
+    eeprom[191] = mlx5_eeprom_sum(eeprom, 128, 190);
+
+    eeprom[192] = 0x0b;         /* extended compliance: 100GBASE-CR4 */
+    snprintf(serial, sizeof(serial), "%02X%02X%02X%02X%02X%02X",
+             s->conf.macaddr.a[0], s->conf.macaddr.a[1], s->conf.macaddr.a[2],
+             s->conf.macaddr.a[3], s->conf.macaddr.a[4], s->conf.macaddr.a[5]);
+    mlx5_eeprom_str(eeprom + 196, 16, serial);
+    mlx5_eeprom_str(eeprom + 212, 8, "260101");
+    eeprom[222] = 103;          /* nominal bit rate, units of 250 Mb/s */
+    eeprom[223] = mlx5_eeprom_sum(eeprom, 192, 222);
+}
+
+/* Module EEPROM access, as an I2C read of up to 48 bytes. */
+static int mlx5_reg_mcia(MLX5State *s, uint8_t *data)
+{
+    uint8_t eeprom[256];
+    uint32_t addr = MLX5_GET(mcia_reg, data, device_address);
+    uint32_t size = MLX5_GET(mcia_reg, data, size);
+    uint8_t *out = MLX5_ADDR_OF(mcia_reg, data, dwords);
+
+    if (MLX5_GET(mcia_reg, data, module) != 0 ||
+        MLX5_GET(mcia_reg, data, i2c_device_address) != 0x50 ||
+        MLX5_GET(mcia_reg, data, page_number) != 0 ||
+        size > MLX5_FLD_SZ_BYTES(mcia_reg, dwords) ||
+        addr + size > sizeof(eeprom)) {
+        MLX5_SET(mcia_reg, data, status, 1);
+        return MLX5_CMD_STAT_OK;
+    }
+    mlx5_module_eeprom(s, eeprom);
+    memcpy(out, eeprom + addr, size);
+    MLX5_SET(mcia_reg, data, status, 0);
+    return MLX5_CMD_STAT_OK;
+}
+
+/* Which registers and optional features exist. */
+static void mlx5_reg_pcam(uint8_t *data)
+{
+    uint8_t *regs = MLX5_ADDR_OF(pcam_reg, data, port_access_reg_cap_mask);
+    uint8_t *feat = MLX5_ADDR_OF(pcam_reg, data, feature_cap_mask);
+
+    if (MLX5_GET(pcam_reg, data, access_reg_group) != 0 ||
+        MLX5_GET(pcam_reg, data, feature_group) != 0) {
+        return;
+    }
+    MLX5_SET(pcam_regs_5000_to_507f, regs, pplm, 1);
+    MLX5_SET(pcam_regs_5000_to_507f, regs, ppcnt, 1);
+    MLX5_SET(pcam_enhanced_features, feat, ptys_connector_type, 1);
+    MLX5_SET(pcam_enhanced_features, feat, pfcc_mask, 1);
+}
+
+static void mlx5_reg_mcam(uint8_t *data)
+{
+    uint8_t *regs = MLX5_ADDR_OF(mcam_reg, data, mng_access_reg_cap_mask);
+
+    if (MLX5_GET(mcam_reg, data, access_reg_group) != 0 ||
+        MLX5_GET(mcam_reg, data, feature_group) != 0) {
+        return;
+    }
+    MLX5_SET(mcam_access_reg, regs, mcqi, 1);
+    MLX5_SET(mcam_access_reg, regs, mcqs, 1);
+    MLX5_SET(mcam_access_reg, regs, mtmp, 1);
+}
+
+/* Firmware components: there is one, the running image. */
+static int mlx5_reg_mcqs(uint8_t *data)
+{
+    if (MLX5_GET(mcqs_reg, data, component_index) != 0) {
+        return MLX5_CMD_STAT_BAD_PARAM_ERR;
+    }
+    MLX5_SET(mcqs_reg, data, last_index_flag, 1);
+    MLX5_SET(mcqs_reg, data, identifier, MLX5_MCQS_IDENTIFIER_BOOT_IMG);
+    return MLX5_CMD_STAT_OK;
+}
+
+static int mlx5_reg_mcqi(MLX5State *s, uint8_t *data, uint32_t len)
+{
+    uint8_t *ver = MLX5_ADDR_OF(mcqi_reg, data, data);
+    g_autofree char *str = NULL;
+
+    if (MLX5_GET(mcqi_reg, data, component_index) != 0 ||
+        MLX5_GET(mcqi_reg, data, info_type) != MLX5_MCQI_INFO_TYPE_VERSION) {
+        return MLX5_CMD_STAT_BAD_PARAM_ERR;
+    }
+    if (len < MLX5_ST_SZ_BYTES(mcqi_reg) + MLX5_ST_SZ_BYTES(mcqi_version)) {
+        return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
+    }
+    str = g_strdup_printf("%u.%u.%04u", s->fw_major, s->fw_minor, s->fw_sub);
+    MLX5_SET(mcqi_reg, data, info_size, MLX5_ST_SZ_BYTES(mcqi_version));
+    MLX5_SET(mcqi_version, ver, version,
+             (uint32_t)s->fw_major << 24 | (s->fw_minor & 0xff) << 16 |
+             s->fw_sub);
+    MLX5_SET(mcqi_version, ver, version_string_length, strlen(str));
+    memcpy(MLX5_ADDR_OF(mcqi_version, ver, version_string), str, strlen(str));
+    return MLX5_CMD_STAT_OK;
+}
+
+/* One temperature sensor, on the ASIC, sitting at a steady 45 degrees. */
+static void mlx5_reg_mtmp(uint8_t *data)
+{
+    if (MLX5_GET(mtmp_reg, data, sensor_index) != 0) {
+        /* A zero temperature reads as "no such sensor". */
+        return;
+    }
+    MLX5_SET(mtmp_reg, data, temperature, MLX5_MTMP_DEG(45));
+    MLX5_SET(mtmp_reg, data, max_temperature, MLX5_MTMP_DEG(45));
+    MLX5_SET(mtmp_reg, data, temp_threshold_hi, MLX5_MTMP_DEG(105));
+    memcpy(MLX5_ADDR_OF(mtmp_reg, data, sensor_name_hi), "asic\0\0\0", 8);
+}
+
+/*
+ * Access one register.  @data holds the register as the driver sent it and,
+ * for reads, receives the device's values.
+ */
+int mlx5_access_reg(MLX5State *s, uint16_t reg_id, bool write, uint8_t *data,
+                    uint32_t len)
+{
+    bool was_up = mlx5_link_up(s);
+
+#define REG_CHECK_LEN(typ)                                              \
+    do {                                                                \
+        if (len < MLX5_ST_SZ_BYTES(typ)) {                              \
+            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;                       \
+        }                                                               \
+    } while (0)
+
+    switch (reg_id) {
+    case MLX5_REG_HOST_ENDIANNESS:
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PMTU:
+        REG_CHECK_LEN(pmtu_reg);
+        if (write) {
+            s->admin_mtu = MLX5_GET(pmtu_reg, data, admin_mtu);
+        } else {
+            MLX5_SET(pmtu_reg, data, max_mtu, MLX5_MAX_MTU);
+            MLX5_SET(pmtu_reg, data, admin_mtu, s->admin_mtu);
+            MLX5_SET(pmtu_reg, data, oper_mtu, s->admin_mtu);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PAOS:
+        REG_CHECK_LEN(paos_reg);
+        if (write) {
+            /* "ase" marks the admin state as being updated. */
+            if (MLX5_GET(paos_reg, data, ase)) {
+                s->port_admin_up =
+                    MLX5_GET(paos_reg, data, admin_status) == MLX5_PORT_UP;
+                if (mlx5_link_up(s) != was_up) {
+                    mlx5_port_event(s);
+                }
+            }
+        } else {
+            MLX5_SET(paos_reg, data, admin_status,
+                     s->port_admin_up ? MLX5_PORT_UP : MLX5_PORT_DOWN);
+            MLX5_SET(paos_reg, data, oper_status,
+                     was_up ? MLX5_PORT_UP : MLX5_PORT_DOWN);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PTYS:
+        REG_CHECK_LEN(ptys_reg);
+        return mlx5_reg_ptys(s, write, data);
+
+    case MLX5_REG_PPLM:
+        REG_CHECK_LEN(pplm_reg);
+        return mlx5_reg_pplm(s, write, data);
+
+    case MLX5_REG_PPCNT:
+        REG_CHECK_LEN(ppcnt_reg);
+        if (!write) {
+            mlx5_reg_ppcnt(s, data);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PFCC:
+        /* Global pause (link-level flow control) settings. */
+        REG_CHECK_LEN(pfcc_reg);
+        if (write) {
+            /* A set "mask_n" bit leaves that direction as it is. */
+            if (!MLX5_GET(pfcc_reg, data, pprx_mask_n)) {
+                s->pause_rx = MLX5_GET(pfcc_reg, data, pprx);
+            }
+            if (!MLX5_GET(pfcc_reg, data, pptx_mask_n)) {
+                s->pause_tx = MLX5_GET(pfcc_reg, data, pptx);
+            }
+        } else {
+            MLX5_SET(pfcc_reg, data, pprx, s->pause_rx);
+            MLX5_SET(pfcc_reg, data, aprx, s->pause_rx);
+            MLX5_SET(pfcc_reg, data, pptx, s->pause_tx);
+            MLX5_SET(pfcc_reg, data, aptx, s->pause_tx);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PMLP:
+        /* All four lanes of the port go to module 0. */
+        REG_CHECK_LEN(pmlp_reg);
+        if (!write) {
+            MLX5_SET(pmlp_reg, data, width, 4);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_PMAOS:
+        REG_CHECK_LEN(pmaos_reg);
+        if (!write) {
+            /* Module plugged in and enabled. */
+            MLX5_SET(pmaos_reg, data, admin_status, 1);
+            MLX5_SET(pmaos_reg, data, oper_status, 1);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_MCIA:
+        REG_CHECK_LEN(mcia_reg);
+        return write ? MLX5_CMD_STAT_OK : mlx5_reg_mcia(s, data);
+
+    case MLX5_REG_PCAM:
+        REG_CHECK_LEN(pcam_reg);
+        if (!write) {
+            mlx5_reg_pcam(data);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_MCAM:
+        REG_CHECK_LEN(mcam_reg);
+        if (!write) {
+            mlx5_reg_mcam(data);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_MCQS:
+        REG_CHECK_LEN(mcqs_reg);
+        return write ? MLX5_CMD_STAT_OK : mlx5_reg_mcqs(data);
+
+    case MLX5_REG_MCQI:
+        REG_CHECK_LEN(mcqi_reg);
+        return write ? MLX5_CMD_STAT_OK : mlx5_reg_mcqi(s, data, len);
+
+    case MLX5_REG_MTCAP:
+        REG_CHECK_LEN(mtcap_reg);
+        if (!write) {
+            MLX5_SET(mtcap_reg, data, sensor_count, 1);
+            MLX5_SET64(mtcap_reg, data, sensor_map, 1);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    case MLX5_REG_MTMP:
+        REG_CHECK_LEN(mtmp_reg);
+        if (!write) {
+            mlx5_reg_mtmp(data);
+        }
+        return MLX5_CMD_STAT_OK;
+
+    default:
+        /*
+         * Unmodelled registers read as zero, which the driver takes as
+         * "nothing supported" for the optional features they describe.
+         */
+        qemu_log_mask(LOG_UNIMP, "mlx5: ACCESS_REG %s of register 0x%x\n",
+                      write ? "write" : "read", reg_id);
+        if (!write) {
+            memset(data, 0, len);
+        }
+        return MLX5_CMD_STAT_OK;
+    }
+#undef REG_CHECK_LEN
+}
+
+void mlx5_reg_reset(MLX5State *s)
+{
+    s->ptys_admin = 0;
+    s->an_disable = false;
+    memset(s->pplm, 0, sizeof(s->pplm));
+    /* Flow control is on in both directions by default, as on hardware. */
+    s->pause_rx = true;
+    s->pause_tx = true;
+}
