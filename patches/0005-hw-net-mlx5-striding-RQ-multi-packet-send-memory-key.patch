-    do {                                                                    \
-        MLX5_SET(ppcnt_reg, data,                                           \
-                 counter_set.eth_802_3_cntrs_grp_data_layout.fld ## _high,  \
-                 (val) >> 32);                                              \
-        MLX5_SET(ppcnt_reg, data,                                           \
-                 counter_set.eth_802_3_cntrs_grp_data_layout.fld ## _low,   \
-                 (val));                                                    \
-    } while (0)
