-                s->pause_tx = MLX5_GET(pfcc_reg, data, pptx);
-            }
-        } else {
-            MLX5_SET(pfcc_reg, data, pprx, s->pause_rx);
-            MLX5_SET(pfcc_reg, data, aprx, s->pause_rx);
-            MLX5_SET(pfcc_reg, data, pptx, s->pause_tx);
-            MLX5_SET(pfcc_reg, data, aptx, s->pause_tx);
-        }
-        return MLX5_CMD_STAT_OK;
-
-    default:
-        /*
-         * Unmodelled registers read as zero, which the driver takes as
-         * "nothing supported" for the optional features they describe.
-         */
-        qemu_log_mask(LOG_UNIMP, "mlx5: ACCESS_REG %s of register 0x%x\n",
-                      write ? "write" : "read", reg_id);
-        if (!write) {
