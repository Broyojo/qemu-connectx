-/*
- * ACCESS_REG reads and writes port and management registers.  @data holds the
- * register on input and, for reads, receives the device's values.
- */
-static int mlx5_access_reg(MLX5State *s, uint16_t reg_id, bool write,
-                           uint8_t *data, uint32_t len)
-{
-    bool was_up = mlx5_link_up(s);
-    uint32_t proto;
-
-    switch (reg_id) {
-    case MLX5_REG_HOST_ENDIANNESS:
-        return MLX5_CMD_STAT_OK;
-
-    case MLX5_REG_PMTU:
-        if (len < MLX5_ST_SZ_BYTES(pmtu_reg)) {
-            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
-        }
-        if (write) {
-            s->admin_mtu = MLX5_GET(pmtu_reg, data, admin_mtu);
-        } else {
-            MLX5_SET(pmtu_reg, data, max_mtu, MLX5_MAX_MTU);
-            MLX5_SET(pmtu_reg, data, admin_mtu, s->admin_mtu);
-            MLX5_SET(pmtu_reg, data, oper_mtu, s->admin_mtu);
-        }
-        return MLX5_CMD_STAT_OK;
-
-    case MLX5_REG_PAOS:
-        if (len < MLX5_ST_SZ_BYTES(paos_reg)) {
-            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
-        }
-        if (write) {
-            /* "ase" marks the admin state as being updated. */
-            if (MLX5_GET(paos_reg, data, ase)) {
-                s->port_admin_up =
-                    MLX5_GET(paos_reg, data, admin_status) == MLX5_PORT_UP;
-                if (mlx5_link_up(s) != was_up) {
-                    mlx5_port_event(s);
-                }
-            }
-        } else {
-            MLX5_SET(paos_reg, data, admin_status,
-                     s->port_admin_up ? MLX5_PORT_UP : MLX5_PORT_DOWN);
-            MLX5_SET(paos_reg, data, oper_status,
-                     was_up ? MLX5_PORT_UP : MLX5_PORT_DOWN);
-        }
-        return MLX5_CMD_STAT_OK;
-
-    case MLX5_REG_PTYS:
-        if (len < MLX5_ST_SZ_BYTES(ptys_reg)) {
-            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
-        }
-        if (!write) {
-            proto = mlx5_speed_to_proto(s->link_speed);
-            MLX5_SET(ptys_reg, data, eth_proto_capability, proto);
-            MLX5_SET(ptys_reg, data, eth_proto_admin, proto);
-            MLX5_SET(ptys_reg, data, eth_proto_oper, was_up ? proto : 0);
-        }
-        return MLX5_CMD_STAT_OK;
-
-    case MLX5_REG_PPCNT:
-        if (len < MLX5_ST_SZ_BYTES(ppcnt_reg)) {
-            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
-        }
-        if (!write) {
-            mlx5_reg_ppcnt(s, data);
-        }
-        return MLX5_CMD_STAT_OK;
-
-    case MLX5_REG_PFCC:
-        /* Global pause (link-level flow control) settings. */
-        if (len < MLX5_ST_SZ_BYTES(pfcc_reg)) {
-            return MLX5_CMD_STAT_BAD_INP_LEN_ERR;
-        }
-        if (write) {
