-/* PTYS speed bit (legacy 32-bit protocol mask) for a link speed in Mb/s. */
-static uint32_t mlx5_speed_to_proto(uint32_t speed)
-{
-    switch (speed) {
-    case 1000:
-        return 1u << 1;     /* 1000BASE-KX */
-    case 10000:
-        return 1u << 4;     /* 10GBASE-KR */
-    case 25000:
-        return 1u << 28;    /* 25GBASE-KR */
-    case 40000:
-        return 1u << 7;     /* 40GBASE-KR4 */
-    case 50000:
-        return 1u << 31;    /* 50GBASE-KR2 */
-    case 100000:
-    default:
-        return 1u << 22;    /* 100GBASE-KR4 */
-    }
-}
